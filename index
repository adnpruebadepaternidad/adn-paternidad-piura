        const WHATSAPP_NUMBER = "51987654321";

        Formato:
        código país + número
        Perú = 51

        NO coloques +, espacios ni guiones.
    -->

    <style>

        /* =========================================================
           VARIABLES
        ========================================================= */

        :root {
            --primary: #0b6b68;
            --primary-dark: #07504e;
            --primary-light: #e8f7f5;

            --secondary: #d9a441;
            --secondary-light: #fff7e5;

            --navy: #12343b;
            --text: #334155;
            --muted: #64748b;

            --white: #ffffff;
            --background: #f7faf9;
            --border: #e2e8f0;

            --success: #25d366;
            --success-dark: #128c7e;

            --danger: #dc2626;

            --shadow-sm:
                0 4px 16px rgba(15, 23, 42, 0.06);

            --shadow:
                0 15px 45px rgba(15, 23, 42, 0.09);

            --shadow-lg:
                0 25px 70px rgba(15, 23, 42, 0.13);

            --radius-sm: 10px;
            --radius: 18px;
            --radius-lg: 28px;

            --container: 1180px;
        }

        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            color: var(--text);
            background: var(--background);
            line-height: 1.6;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        .container {
            width: min(
                calc(100% - 40px),
                var(--container)
            );

            margin-inline: auto;
        }

        /* =========================================================
           ICONS
        ========================================================= */

        .icon {
            width: 22px;
            height: 22px;
            display: inline-block;
            flex-shrink: 0;
        }

        .icon-sm {
            width: 18px;
            height: 18px;
        }

        .icon-lg {
            width: 28px;
            height: 28px;
        }

        /* =========================================================
           TOP BAR
        ========================================================= */

        .topbar {
            background: var(--navy);
            color: rgba(255,255,255,.92);
            font-size: 13px;
        }

        .topbar-inner {
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .topbar-left,
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .topbar-item {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        /* =========================================================
           HEADER
        ========================================================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255,255,255,.94);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(226,232,240,.8);
        }

        .navbar {
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-mark {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background:
                linear-gradient(
                    145deg,
                    var(--primary),
                    #0f8c84
                );
            color: white;
            box-shadow: 0 8px 20px rgba(11,107,104,.22);
        }

        .logo-text {
            line-height: 1.1;
        }

        .logo-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--navy);
        }

        .logo-subtitle {
            font-size: 11px;
            color: var(--muted);
            margin-top: 3px;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 26px;
        }

        .nav a {
            color: #475569;
            font-size: 14px;
            font-weight: 600;
            transition: .2s ease;
        }

        .nav a:hover {
            color: var(--primary);
        }

        .nav-cta {
            display: inline-flex !important;
            align-items: center;
            gap: 8px;
            color: white !important;
            background: var(--primary);
            padding: 12px 17px;
            border-radius: 12px;
        }

        .nav-cta:hover {
            background: var(--primary-dark);
        }

        .mobile-menu-button {
            display: none;
            border: 0;
            background: transparent;
            color: var(--navy);
        }

        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at 85% 15%,
                    rgba(217,164,65,.15),
                    transparent 28%
                ),
                linear-gradient(
                    135deg,
                    #f7fcfb 0%,
                    #ffffff 58%,
                    #eef9f7 100%
                );

            padding:
                78px
                0
                82px;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            right: -230px;
            top: -250px;
            border-radius: 50%;
            background: rgba(11,107,104,.06);
        }

        .hero-grid {
            position: relative;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            gap: 65px;
            align-items: center;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--primary-light);
            color: var(--primary-dark);
            border: 1px solid #ccebe8;
            padding: 8px 13px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .02em;
            margin-bottom: 20px;
        }

        .eyebrow-dot {
            width: 8px;
            height: 8px;
            background: var(--primary);
            border-radius: 50%;
            box-shadow: 0 0 0 5px rgba(11,107,104,.1);
        }

        .hero h1 {
            font-size: clamp(39px, 5vw, 64px);
            line-height: 1.04;
            letter-spacing: -0.045em;
            color: var(--navy);
            max-width: 700px;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .hero-description {
            margin-top: 22px;
            max-width: 610px;
            color: #526274;
            font-size: 18px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
            margin-top: 30px;
        }

        .btn {
            min-height: 50px;
            padding: 13px 19px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border: 1px solid transparent;
            font-weight: 750;
            font-size: 14px;
            transition:
                transform .2s ease,
                box-shadow .2s ease,
                background .2s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-primary {
            color: white;
            background: var(--primary);
            box-shadow:
                0 10px 25px rgba(11,107,104,.20);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            box-shadow:
                0 14px 32px rgba(11,107,104,.25);
        }

        .btn-whatsapp {
            color: white;
            background: var(--success);
            box-shadow:
                0 10px 25px rgba(37,211,102,.18);
        }

        .btn-whatsapp:hover {
            background: var(--success-dark);
        }

        .btn-outline {
            background: white;
            color: var(--navy);
            border-color: var(--border);
        }

        .btn-outline:hover {
            border-color: #b8c5d2;
            box-shadow: var(--shadow-sm);
        }

        .trust-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 28px;
            color: var(--muted);
            font-size: 13px;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .trust-item svg {
            color: var(--primary);
        }

        /* Hero visual */

        .hero-visual {
            position: relative;
        }

        .hero-card {
            position: relative;
            background: white;
            border: 1px solid rgba(226,232,240,.85);
            border-radius: 30px;
            box-shadow: var(--shadow-lg);
            padding: 25px;
            overflow: hidden;
        }

        .hero-image {
            height: 370px;
            border-radius: 22px;
            overflow: hidden;
            position: relative;
            background:
                linear-gradient(
                    145deg,
                    #dff3ef,
                    #f9fbfb
                );
        }

        /*
            Imagen remota de Unsplash.

            Puedes reemplazarla por una fotografía propia:
            images/familia-adn.jpg
        */

        .hero-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-image-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(
                    to top,
                    rgba(18,52,59,.65),
                    transparent 60%
                );
        }

        .hero-image-caption {
            position: absolute;
            left: 22px;
            right: 22px;
            bottom: 20px;
            color: white;
        }

        .hero-image-caption strong {
            display: block;
            font-size: 20px;
            line-height: 1.2;
        }

        .hero-image-caption span {
            font-size: 13px;
            opacity: .9;
        }

        .floating-info {
            position: absolute;
            background: white;
            border-radius: 15px;
            padding: 13px 15px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        .floating-info.top {
            top: 30px;
            left: -32px;
        }

        .floating-info.bottom {
            right: -30px;
            bottom: 32px;
        }

        .floating-info-inner {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .floating-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: var(--primary-light);
            color: var(--primary);
        }

        .floating-info strong {
            display: block;
            color: var(--navy);
            font-size: 13px;
        }

        .floating-info span {
            display: block;
            color: var(--muted);
            font-size: 11px;
        }

        /* =========================================================
           SECTION COMMON
        ========================================================= */

        section {
            padding: 90px 0;
        }

        .section-header {
            max-width: 720px;
            margin: 0 auto 50px;
            text-align: center;
        }

        .section-kicker {
            display: inline-block;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: .12em;
            font-size: 11px;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .section-title {
            font-size: clamp(30px, 4vw, 44px);
            color: var(--navy);
            line-height: 1.1;
            letter-spacing: -.035em;
        }

        .section-description {
            margin-top: 14px;
            color: var(--muted);
            font-size: 16px;
        }

        /* =========================================================
           TRUST STRIP
        ========================================================= */

        .trust-strip {
            background: white;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .trust-strip-grid {
            display: grid;
            grid-template-columns:
                repeat(4, 1fr);
        }

        .trust-box {
            padding: 28px 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border-right: 1px solid var(--border);
        }

        .trust-box:last-child {
            border-right: 0;
        }

        .trust-box-icon {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            color: var(--primary);
            background: var(--primary-light);
        }

        .trust-box strong {
            display: block;
            color: var(--navy);
            font-size: 14px;
        }

        .trust-box span {
            display: block;
            color: var(--muted);
            font-size: 12px;
        }

        /* =========================================================
           TYPES
        ========================================================= */

        .types-section {
            background: #fff;
        }

        .cards-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 20px;
        }

        .service-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 27px;
            transition:
                transform .25s ease,
                box-shadow .25s ease,
                border-color .25s ease;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow);
            border-color: #c6dedc;
        }

        .service-card.featured {
            border-color: #9dd5d0;
            box-shadow:
                0 12px 35px rgba(11,107,104,.08);
        }

        .service-icon {
            width: 52px;
            height: 52px;
            border-radius: 15px;
            background: var(--primary-light);
            color: var(--primary);
            display: grid;
            place-items: center;
            margin-bottom: 20px;
        }

        .service-card h3 {
            color: var(--navy);
            font-size: 20px;
            margin-bottom: 9px;
        }

        .service-card p {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 19px;
        }

        .service-list {
            list-style: none;
            display: grid;
            gap: 9px;
        }

        .service-list li {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            color: #475569;
            font-size: 13px;
        }

        .service-list svg {
            color: var(--primary);
            margin-top: 3px;
        }

        .service-footer {
            margin-top: 23px;
            padding-top: 17px;
            border-top: 1px solid var(--border);
        }

        .service-link {
            color: var(--primary);
            font-size: 13px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* =========================================================
           COMPARISON
        ========================================================= */

        .comparison {
            background: var(--background);
        }

        .comparison-wrapper {
            overflow-x: auto;
            background: white;
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
        }

        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 760px;
        }

        .comparison-table th,
        .comparison-table td {
            padding: 19px 20px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        .comparison-table th {
            background: #f8fbfb;
            color: var(--navy);
            font-size: 13px;
        }

        .comparison-table td {
            color: var(--muted);
            font-size: 13px;
        }

        .comparison-table tr:last-child td {
            border-bottom: 0;
        }

        .comparison-table .check {
            color: var(--primary);
            font-weight: 800;
        }

        /* =========================================================
           PROCESS
        ========================================================= */

        .process {
            background: white;
        }

        .process-grid {
            display: grid;
            grid-template-columns:
                repeat(4, 1fr);
            gap: 18px;
            position: relative;
        }

        .process-grid::before {
            content: "";
            position: absolute;
            top: 42px;
            left: 10%;
            right: 10%;
            height: 1px;
            background: #cfe5e2;
            z-index: 0;
        }

        .process-step {
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .process-number {
            width: 84px;
            height: 84px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: white;
            border: 8px solid #edf8f6;
            box-shadow: 0 0 0 1px #cfe5e2;
            display: grid;
            place-items: center;
            color: var(--primary);
            font-size: 20px;
            font-weight: 900;
        }

        .process-step h3 {
            color: var(--navy);
            font-size: 17px;
            margin-bottom: 7px;
        }

        .process-step p {
            color: var(--muted);
            font-size: 13px;
            max-width: 230px;
            margin: auto;
        }

        /* =========================================================
           INFO SPLIT
        ========================================================= */

        .info-section {
            background:
                linear-gradient(
                    135deg,
                    #f0f9f7,
                    #fff
                );
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 70px;
            align-items: center;
        }

        .info-image {
            min-height: 500px;
            border-radius: 28px;
            overflow: hidden;
            position: relative;
            box-shadow: var(--shadow);
        }

        .info-image img {
            width: 100%;
            height: 100%;
            min-height: 500px;
            object-fit: cover;
        }

        .info-image-label {
            position: absolute;
            bottom: 22px;
            left: 22px;
            right: 22px;
            background: rgba(255,255,255,.94);
            backdrop-filter: blur(10px);
            padding: 17px;
            border-radius: 16px;
        }

        .info-image-label strong {
            color: var(--navy);
            display: block;
        }

        .info-image-label span {
            color: var(--muted);
            font-size: 12px;
        }

        .info-content .section-kicker {
            margin-bottom: 10px;
        }

        .info-content h2 {
            color: var(--navy);
            font-size: clamp(31px, 4vw, 45px);
            line-height: 1.1;
            letter-spacing: -.04em;
        }

        .info-content > p {
            color: var(--muted);
            margin-top: 17px;
            font-size: 15px;
        }

        .benefits {
            list-style: none;
            margin-top: 25px;
            display: grid;
            gap: 16px;
        }

        .benefit {
            display: flex;
            gap: 13px;
        }

        .benefit-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: white;
            color: var(--primary);
            border: 1px solid #d7e9e7;
        }

        .benefit strong {
            color: var(--navy);
            display: block;
            font-size: 14px;
        }

        .benefit span {
            color: var(--muted);
            font-size: 13px;
        }

        /* =========================================================
           FORM
        ========================================================= */

        .contact-section {
            background: var(--navy);
            color: white;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            gap: 60px;
            align-items: start;
        }

        .contact-content .section-kicker {
            color: #7fd5ce;
        }

        .contact-content h2 {
            font-size: clamp(32px, 4vw, 48px);
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .contact-content > p {
            color: rgba(255,255,255,.72);
            margin-top: 17px;
            max-width: 470px;
        }

        .contact-points {
            margin-top: 28px;
            display: grid;
            gap: 15px;
        }

        .contact-point {
            display: flex;
            gap: 11px;
            align-items: flex-start;
        }

        .contact-point-icon {
            color: #7fd5ce;
            margin-top: 2px;
        }

        .contact-point strong {
            display: block;
            font-size: 14px;
        }

        .contact-point span {
            color: rgba(255,255,255,.64);
            font-size: 12px;
        }

        .form-card {
            background: white;
            color: var(--text);
            border-radius: 25px;
            padding: 31px;
            box-shadow: var(--shadow-lg);
        }

        .form-card h3 {
            color: var(--navy);
            font-size: 24px;
        }

        .form-card > p {
            color: var(--muted);
            font-size: 13px;
            margin-top: 5px;
            margin-bottom: 23px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        label {
            color: var(--navy);
            font-size: 12px;
            font-weight: 800;
        }

        input,
        select,
        textarea {
            width: 100%;
            border: 1px solid #d9e1e8;
            background: #fbfcfd;
            border-radius: 11px;
            padding: 12px 13px;
            outline: none;
            color: var(--text);
            transition: .2s ease;
        }

        input,
        select {
            height: 47px;
        }

        textarea {
            min-height: 105px;
            resize: vertical;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #6dbdb7;
            box-shadow:
                0 0 0 4px rgba(11,107,104,.08);
            background: white;
        }

        .form-checkbox {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-top: 4px;
        }

        .form-checkbox input {
            width: 17px;
            height: 17px;
            margin-top: 2px;
        }

        .form-checkbox label {
            color: var(--muted);
            font-weight: 500;
            font-size: 11px;
        }

        .form-checkbox a {
            color: var(--primary);
            font-weight: 700;
        }

        .form-submit {
            width: 100%;
            margin-top: 17px;
        }

        .form-note {
            text-align: center;
            margin-top: 11px;
            color: var(--muted);
            font-size: 10px;
        }

        /* =========================================================
           FAQ
        ========================================================= */

        .faq {
            background: white;
        }

        .faq-container {
            max-width: 850px;
            margin: auto;
        }

        .faq-item {
            border-bottom: 1px solid var(--border);
        }

        .faq-question {
            width: 100%;
            background: transparent;
            border: 0;
            padding: 20px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            text-align: left;
            color: var(--navy);
            font-weight: 800;
            font-size: 15px;
        }

        .faq-question svg {
            transition: transform .25s ease;
            flex-shrink: 0;
            color: var(--primary);
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition:
                max-height .3s ease,
                padding .3s ease;
        }

        .faq-answer p {
            color: var(--muted);
            font-size: 14px;
            padding-bottom: 0;
        }

        .faq-item.active .faq-answer {
            max-height: 300px;
        }

        .faq-item.active .faq-answer p {
            padding-bottom: 20px;
        }

        .faq-item.active .faq-question svg {
            transform: rotate(180deg);
        }

        /* =========================================================
           CTA
        ========================================================= */

        .cta-section {
            padding: 45px 0;
            background: var(--background);
        }

        .cta-box {
            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    #087d78
                );
            color: white;
            border-radius: 25px;
            padding: 42px 45px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            box-shadow:
                0 20px 50px rgba(11,107,104,.18);
        }

        .cta-box h2 {
            font-size: 30px;
            line-height: 1.15;
        }

        .cta-box p {
            margin-top: 7px;
            color: rgba(255,255,255,.75);
            font-size: 14px;
        }

        .cta-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .cta-actions .btn-outline {
            background: white;
            border-color: white;
        }

        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            background: #0c252b;
            color: white;
            padding: 55px 0 25px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.3fr 1fr 1fr 1fr;
            gap: 45px;
        }

        .footer-brand p {
            color: rgba(255,255,255,.58);
            margin-top: 15px;
            max-width: 330px;
            font-size: 13px;
        }

        .footer-title {
            font-weight: 800;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .footer-links {
            list-style: none;
            display: grid;
            gap: 9px;
        }

        .footer-links a {
            color: rgba(255,255,255,.58);
            font-size: 12px;
            transition: .2s ease;
        }

        .footer-links a:hover {
            color: white;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,.1);
            margin-top: 40px;
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            color: rgba(255,255,255,.42);
            font-size: 11px;
        }

        /* =========================================================
           WHATSAPP FLOATING BUTTON
        ========================================================= */

        .whatsapp-float {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1100;

            width: 61px;
            height: 61px;

            border-radius: 50%;

            display: grid;
            place-items: center;

            background: var(--success);
            color: white;

            box-shadow:
                0 10px 30px rgba(37,211,102,.35);

            transition: .25s ease;
        }

        .whatsapp-float:hover {
            transform: scale(1.07);
            background: var(--success-dark);
        }

        .whatsapp-pulse {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid rgba(37,211,102,.55);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
                opacity: .8;
            }

            70% {
                transform: scale(1.35);
                opacity: 0;
            }

            100% {
                transform: scale(1.35);
                opacity: 0;
            }
        }

        /* =========================================================
           MOBILE CTA
        ========================================================= */

        .mobile-bottom-bar {
            display: none;
        }

        /* =========================================================
           ANIMATIONS
        ========================================================= */

        .fade-up {
            opacity: 0;
            transform: translateY(18px);
            transition:
                opacity .7s ease,
                transform .7s ease;
        }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 1050px) {

            .nav {
                gap: 16px;
