                border-right: 0;
            }

            .trust-box:nth-child(-n+2) {
                border-bottom: 1px solid var(--border);
            }

            .cards-grid {
                grid-template-columns: 1fr 1fr;
            }

            .process-grid {
                grid-template-columns: 1fr 1fr;
                gap: 35px;
            }

            .process-grid::before {
                display: none;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cta-box {
                flex-direction: column;
                align-items: flex-start;
            }

        }

        @media (max-width: 600px) {

            .container {
                width: min(
                    calc(100% - 28px),
                    var(--container)
                );
            }

            section {
                padding: 65px 0;
            }

            .hero {
                padding: 42px 0 55px;
            }

            .hero h1 {
                font-size: 39px;
            }

            .hero-description {
                font-size: 16px;
            }

            .hero-actions {
                flex-direction: column;
            }

            .hero-actions .btn {
                width: 100%;
            }

            .hero-image {
                height: 300px;
            }

            .floating-info {
                position: relative;
                inset: auto !important;
                margin-top: 10px;
            }

            .trust-strip-grid {
                grid-template-columns: 1fr;
            }

            .trust-box {
                border-right: 0 !important;
                border-bottom: 1px solid var(--border);
                justify-content: flex-start;
            }

            .trust-box:last-child {
                border-bottom: 0;
            }

            .cards-grid {
                grid-template-columns: 1fr;
            }

            .process-grid {
                grid-template-columns: 1fr;
                gap: 28px;
            }

            .info-image,
            .info-image img {
                min-height: 360px;
            }

            .form-card {
                padding: 22px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .cta-box {
